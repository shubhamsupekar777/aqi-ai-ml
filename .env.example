# ==============================================================================
# AQI AI — Environmental Intelligence Platform Environment Configuration
# Copy this file to .env in the project root, or set variables independently
# in backend/.env and frontend/.env.
# ==============================================================================

# Application Environment
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL primary; automatic SQLite fallback if unreachable)
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aqi_ai
DATABASE_URL=postgresql://postgres:Shubham12345@localhost:5432/aqi

SQLITE_FALLBACK_URL=sqlite:///./aqi_ai.db

# Docker Compose Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aqi_ai
POSTGRES_PORT=5432

# CORS Whitelist (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ML Inference Mode
# "demo" simulates physical diurnal dispersion with deterministic atmospheric dynamics
# "ml" attempts loading serialized scikit-learn/XGBoost model bundles from MODEL_DIR
PREDICTION_MODE=ml
MODEL_DIR=backend/app/ml/models

# Regulatory Standard Default: "epa" (US EPA AQI 0-500) or "cpcb" (Indian CPCB NAQI 0-500)
DEFAULT_STANDARD=epa

# ==============================================================================
# Frontend Client Configuration (Vite)
# ==============================================================================
# Backend REST API Base URL
VITE_API_BASE_URL=http://localhost:8000

# Client Data Mode: "api" (live backend calls with mock fallback) or "mock" (offline standalone)
VITE_DATA_MODE=api

# Default regulatory standard in UI
VITE_DEFAULT_STANDARD=epa

# Analytics & Monitoring
VITE_ENABLE_ANALYTICS=false
DATA_GOV_IN_API_KEY=579b464db66ec23bdd000001cdd3946e44ce4aad7209ff7b23ac571b
AQI_API_KEY=aqi_hpEaB8glorXS1zt3NBusa5rgEWI6h4ifzdXTuQ4PEJA
OPENAQ_API_KEY=10fc22b9ee1e206ddaa6e451f917b26235a989516db23ad1166a5482d765b3a1