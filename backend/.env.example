# Backend Environment Configuration
APP_NAME="AQI AI — Environmental Intelligence Platform"
APP_ENV=development
DEBUG=true

# Database Connection (PostgreSQL with psycopg3 driver)
# DATABASE_URL=postgresql+psycopg://aqi_user:aqi_password@localhost:5432/aqi_ai
DATABASE_URL=postgresql://postgres:Shubham12345@localhost:5432/aqi


# Fallback SQLite DB URL (active when PostgreSQL container is offline)
SQLITE_FALLBACK_URL=sqlite:///./aqi_ai.db

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ML Inference Mode: 'demo' (rule-based simulation) or 'ml' (load real model artifacts)
PREDICTION_MODE=demo
MODEL_DIR=app/ml/models
PREDICTION_MODE=ml
