# Frontend Environment Variables
# DATA_MODE can be 'mock' (uses typed demo fixtures) or 'api' (connects to FastAPI backend)
# VITE_DATA_MODE=mock

# # Base URL for FastAPI Backend endpoints
# VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DATA_MODE=api
VITE_API_BASE_URL=http://localhost:8000/api/v1